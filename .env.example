# Public site URL (used for metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: full URL of POST /api/orders when the API is hosted on another origin.
# Leave empty to use this app's own /api/orders route.
NEXT_PUBLIC_ORDERS_API_URL=

# Footer contact details (hidden when empty)
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_ADDRESS=

# ---- Server-side only (never prefix with NEXT_PUBLIC_) ----
MONGODB_URI=
# Optional, defaults to "vappino"
MONGODB_DB=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1356616710875243
OWNER_WHATSAPP_NUMBER=21651144339
# Optional: Graph API version (default v21.0)
WHATSAPP_API_VERSION=
# Optional: approved template name/language. When set, orders are sent as a template
# (body variables {{1}}..{{6}} = reference, name, phone, products, total, notes).
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=fr

# Protects POST /api/test-whatsapp (send as "Authorization: Bearer <key>")
ADMIN_API_KEY=

# Optional: comma-separated extra origins allowed to call /api/orders (e.g. https://nourabm33.github.io)
ALLOWED_ORIGINS=
